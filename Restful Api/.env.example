# Copy to .env.local (gitignored) for local development, or set these as real
# environment variables / Render env vars in production.

# Postgres connection string, JDBC form. For Supabase: Project Settings ->
# Database -> Connection string -> use the DIRECT connection (port 5432),
# not the "Transaction pooler" (6543) -- the pooler doesn't support the
# prepared statements Hibernate relies on.
# jdbc:postgresql://<host>:5432/postgres?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/libman
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=changeme

# Any random string of 32+ characters (e.g. `openssl rand -base64 48`) --
# used directly as UTF-8 bytes for HS256 signing, so it needs to be at least
# 32 characters long to give 256 bits of key material.
JWT_SECRET=changeme-generate-a-real-32-plus-character-secret
JWT_EXPIRATION_MS=86400000

CORS_ALLOWED_ORIGINS=http://localhost:3000

PORT=8080

# Used only for uploading ebook files to Supabase Storage (bucket "ebooks").
# Project Settings -> API -> Project API keys -> service_role ("secret").
# This key bypasses all database/storage security rules -- never expose it
# to the frontend, never commit it.
SUPABASE_STORAGE_URL=https://<project-ref>.supabase.co/storage/v1
SUPABASE_SERVICE_ROLE_KEY=changeme

# Paystack Dashboard -> Settings -> API Keys & Webhooks -> Secret Key.
# Used server-side only, to verify a transaction really succeeded before
# marking a charge paid -- never expose this one to the frontend (the
# public key is the one the frontend uses, and is safe to expose).
PAYSTACK_SECRET_KEY=sk_test_changeme
